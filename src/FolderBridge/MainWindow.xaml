<local:XpWindow x:Class="FolderBridge.MainWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:FolderBridge"
                Title="Folder Bridge" Width="900" Height="600" MinWidth="760" MinHeight="480"
                ShowTitleIcon="True" WindowStartupLocation="CenterScreen">

    <local:XpWindow.Resources>

        <DataTemplate x:Key="ActionCell">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding Details}">
                <Image Source="{Binding Icon}" Width="14" Height="14" Margin="0,0,5,0" />
                <TextBlock Text="{Binding Action}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SizeCell">
            <TextBlock Text="{Binding Size}" HorizontalAlignment="Right" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:FolderVm}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Image Source="{DynamicResource Icon.Folder}" Width="48" Height="48" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="PauseFolder_Click" MinWidth="82" AutomationProperties.Name="{Binding PauseText}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding PauseIcon}" Width="14" Height="14" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding PauseText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Content="Open folder" Margin="6,0,0,0" Click="OpenFolder_Click" />
                        <Button Content="Remove..." Margin="6,0,0,0" Click="RemoveFolder_Click" />
                    </StackPanel>
                    <StackPanel Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource DetailTitle}" />
                        <TextBlock Text="{Binding Path}" Foreground="#555555" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>

                <GroupBox Header="Status" DockPanel.Dock="Top" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="18" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Files:" Foreground="#555555" />
                            <TextBlock Grid.Column="1" Text="{Binding Files}" />
                            <TextBlock Grid.Column="2" Text="Remaining:" Foreground="#555555" />
                            <TextBlock Grid.Column="3" Text="{Binding Remaining}" />
                            <TextBlock Grid.Row="1" Text="Size:" Foreground="#555555" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Size}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Speed:" Foreground="#555555" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Speed}" />
                            <TextBlock Grid.Row="2" Text="Shared with:" Foreground="#555555" Margin="0,2,0,0" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2,0,0">
                                <ItemsControl ItemsSource="{Binding Shares}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsShared}" Margin="0,0,16,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No paired computers yet. Pair one from the Tasks list." Foreground="#555555"
                                           Visibility="{Binding HasNoShares, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                        <DockPanel Margin="0,10,0,5">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" Margin="8,0,0,0" />
                            <Image Source="{Binding StatusIcon}" Width="14" Height="14" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding StatusLine}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding StatusLine}" />
                        </DockPanel>
                        <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" />
                    </StackPanel>
                </GroupBox>

                <TextBlock DockPanel.Dock="Top" Text="Activity" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                <ListView ItemsSource="{Binding Activity}">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Header="Time" Width="46" DisplayMemberBinding="{Binding Time}" />
                            <GridViewColumn Header="Action" Width="112" CellTemplate="{StaticResource ActionCell}" />
                            <GridViewColumn Header="File" Width="230" DisplayMemberBinding="{Binding File}" />
                            <GridViewColumn Header="Computer" Width="100" DisplayMemberBinding="{Binding Device}" />
                            <GridViewColumn Header="Size" Width="66" CellTemplate="{StaticResource SizeCell}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:DeviceVm}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Image Source="{Binding Icon}" Width="48" Height="48" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PairButton" Content="Pair..." Click="PairNearby_Click" Visibility="Collapsed" />
                        <Button x:Name="UnpairButton" Content="Unpair..." Click="Unpair_Click" />
                    </StackPanel>
                    <StackPanel Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource DetailTitle}" />
                        <TextBlock Text="{Binding Sub}" Foreground="#555555" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>

                <GroupBox Header="Computer" DockPanel.Dock="Top" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Status:" Foreground="#555555" Margin="0,0,0,4" />
                        <TextBlock Grid.Column="1" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="1" Text="Address:" Foreground="#555555" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Address}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="Folders:" Foreground="#555555" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Folders}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="3" Text="Device ID:" Foreground="#555555" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding IdText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" VerticalAlignment="Center" />
                    </Grid>
                </GroupBox>

                <TextBlock DockPanel.Dock="Top" Text="Activity" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                <ListView ItemsSource="{Binding Activity}">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Header="Time" Width="46" DisplayMemberBinding="{Binding Time}" />
                            <GridViewColumn Header="Action" Width="112" CellTemplate="{StaticResource ActionCell}" />
                            <GridViewColumn Header="File" Width="330" DisplayMemberBinding="{Binding File}" />
                            <GridViewColumn Header="Size" Width="66" CellTemplate="{StaticResource SizeCell}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPaired}" Value="False">
                    <Setter TargetName="PairButton" Property="Visibility" Value="Visible" />
                    <Setter TargetName="UnpairButton" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:WelcomeVm}">
            <StackPanel>
                <DockPanel>
                    <Image Source="{DynamicResource Icon.App}" Width="48" Height="48" />
                    <StackPanel Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="Welcome to Folder Bridge" Style="{StaticResource DetailTitle}" />
                        <TextBlock Text="Keep a folder the same on two computers over your home network." Foreground="#555555" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
                <GroupBox Header="Getting started" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" LineHeight="18">
                            1. Open Folder Bridge on the other computer too.<LineBreak />
                            2. Click Pair a device and check that both screens show the same code.<LineBreak />
                            3. Click Add a folder, choose the folder and tick the other computer.<LineBreak />
                            4. Accept the folder on the other computer and choose where to keep it.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Pair a device..." Click="Pair_Click" MinWidth="110" />
                            <Button Content="Add a folder..." Click="AddFolder_Click" MinWidth="110" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </DataTemplate>

    </local:XpWindow.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Height="22" BorderBrush="White" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Margin="6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="1" BorderBrush="#C2BFA5" BorderThickness="1,0,0,0" Margin="0,3">
                    <TextBlock Text="{Binding DownText}" Margin="10,0" MinWidth="90" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Column="2" BorderBrush="#C2BFA5" BorderThickness="1,0,0,0" Margin="0,3">
                    <TextBlock Text="{Binding UpText}" Margin="10,0" MinWidth="90" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Column="3" BorderBrush="#C2BFA5" BorderThickness="1,0,0,0" Margin="0,3">
                    <TextBlock Text="{Binding DeviceName}" Margin="10,0" VerticalAlignment="Center" />
                </Border>
                <Grid Grid.Column="4" Background="Transparent" WindowChrome.ResizeGripDirection="BottomRight" Width="12" Height="12"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1">
                    <Path Data="M9,1 h2 v2 h-2 Z M5,5 h2 v2 h-2 Z M9,5 h2 v2 h-2 Z M1,9 h2 v2 h-2 Z M5,9 h2 v2 h-2 Z M9,9 h2 v2 h-2 Z" Fill="White" Margin="1,1,0,0" />
                    <Path Data="M9,1 h2 v2 h-2 Z M5,5 h2 v2 h-2 Z M9,5 h2 v2 h-2 Z M1,9 h2 v2 h-2 Z M5,9 h2 v2 h-2 Z M9,9 h2 v2 h-2 Z" Fill="#B8B4A2" />
                </Grid>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource TaskPane}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="12">
                        <Expander Header="Folders" Style="{StaticResource TaskGroup}" Tag="Special">
                            <StackPanel>
                                <ListBox x:Name="FolderList" ItemsSource="{Binding Folders}" Style="{StaticResource TaskList}" SelectionChanged="FolderList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Image Source="{DynamicResource Icon.Folder}" Width="16" Height="16" />
                                                <Image DockPanel.Dock="Right" Source="{Binding StatusIcon}" Width="14" Height="14" ToolTip="{Binding StatusLine}" />
                                                <TextBlock Text="{Binding Name}" Margin="6,0,4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="No folders yet." Foreground="#5A6E9A" Margin="0,0,0,5"
                                           Visibility="{Binding HasNoFolders, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding Offers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource TaskLink}" Tag="{DynamicResource Icon.Add}" Content="{Binding Text}" Click="Offer_Click" Margin="0,3,0,3" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Devices" Style="{StaticResource TaskGroup}">
                            <StackPanel>
                                <ListBox x:Name="DeviceList" ItemsSource="{Binding Devices}" Style="{StaticResource TaskList}" SelectionChanged="DeviceList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0" />
                                                <StackPanel Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Sub}" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="Looking for computers on this network..." Foreground="#5A6E9A" TextWrapping="Wrap" Margin="0,0,0,5"
                                           Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Expander>

                        <Expander Header="Tasks" Style="{StaticResource TaskGroup}">
                            <StackPanel>
                                <Button Style="{StaticResource TaskLink}" Tag="{DynamicResource Icon.Add}" Content="Add a folder" Click="AddFolder_Click" />
                                <Button Style="{StaticResource TaskLink}" Tag="{DynamicResource Icon.Pair}" Content="Pair a device" Click="Pair_Click" />
                                <Button Style="{StaticResource TaskLink}" Tag="{DynamicResource Icon.Sync}" Content="Sync all now" Click="SyncAll_Click" />
                                <Button Style="{StaticResource TaskLink}" Tag="{DynamicResource Icon.Gear}" Content="Settings" Click="Settings_Click" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#9DB3E4" BorderThickness="1,0,0,0">
                <ContentControl Content="{Binding Detail}" Margin="20,16,20,14" Focusable="False" />
            </Border>
        </Grid>
    </DockPanel>
</local:XpWindow>
