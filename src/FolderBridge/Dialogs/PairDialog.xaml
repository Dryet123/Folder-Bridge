<local:XpWindow x:Class="FolderBridge.Dialogs.PairDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:FolderBridge"
                Title="Pair a device" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
                WindowStartupLocation="CenterOwner">
    <Grid Margin="14,14,14,12" Width="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
            <Image Source="{DynamicResource Icon.Pair}" Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,14,0" />
            <Grid>
                <StackPanel x:Name="ChoosePage">
                    <TextBlock Text="Computers on this network with Folder Bridge open:" TextWrapping="Wrap" />
                    <ListBox x:Name="NearbyList" Height="92" Margin="0,6,0,0" SelectionChanged="NearbyList_SelectionChanged" MouseDoubleClick="NearbyList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Address}" Opacity="0.7" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoneFound" Text="None found yet. Open Folder Bridge on the other computer and keep this window open."
                               TextWrapping="Wrap" Foreground="#555555" Margin="0,5,0,0" />
                    <TextBlock Text="Or type its address, for example 192.168.1.20" TextWrapping="Wrap" Margin="0,10,0,4" />
                    <TextBox x:Name="AddressBox" TextChanged="AddressBox_TextChanged" />
                </StackPanel>

                <StackPanel x:Name="CodePage" Visibility="Collapsed">
                    <TextBlock x:Name="CodeIntro" TextWrapping="Wrap" />
                    <TextBlock Text="Make sure the other computer shows the same code:" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <Border BorderBrush="{StaticResource FieldBorder}" BorderThickness="1" Background="White" Margin="0,10,0,0" Padding="0,5">
                        <TextBlock x:Name="CodeText" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="CodeStatus" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#555555" />
                </StackPanel>

                <TextBlock x:Name="MessageText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8,0,0" />
            </Grid>
        </DockPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="PrimaryButton" Content="Next" IsDefault="True" Click="Primary_Click" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Margin="6,0,0,0" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</local:XpWindow>
