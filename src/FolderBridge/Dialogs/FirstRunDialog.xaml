<local:XpWindow x:Class="FolderBridge.Dialogs.FirstRunDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:FolderBridge"
                Title="Folder Bridge" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
                ShowTitleIcon="True">
    <Grid Margin="14,14,14,12" Width="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
            <Image Source="{DynamicResource Icon.App}" Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,14,0" />
            <StackPanel>
                <TextBlock Text="Folder Bridge is ready." FontWeight="Bold" />
                <TextBlock Text="It keeps running in the tray next to the clock when you close its window." TextWrapping="Wrap" Margin="0,4,0,0" />
                <CheckBox x:Name="ShortcutBox" Content="Put a shortcut on the desktop" IsChecked="True" Margin="0,12,0,0" />
                <CheckBox x:Name="AutostartBox" Content="Start Folder Bridge when Windows starts" IsChecked="True" Margin="0,8,0,0" />
                <TextBlock x:Name="PathText" TextWrapping="Wrap" Foreground="#555555" Margin="0,12,0,0" />
            </StackPanel>
        </DockPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</local:XpWindow>
