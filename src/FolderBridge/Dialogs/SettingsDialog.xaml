<local:XpWindow x:Class="FolderBridge.Dialogs.SettingsDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:local="clr-namespace:FolderBridge"
                Title="Settings" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
                WindowStartupLocation="CenterOwner">
    <Grid Margin="14,14,14,12" Width="420">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
            <Image Source="{DynamicResource Icon.Gear}" Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,14,0" />
            <StackPanel>
                <GroupBox Header="This computer" Background="{StaticResource Face}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Name:" VerticalAlignment="Center" />
                            <TextBox x:Name="NameBox" Grid.Column="1" />
                            <TextBlock Grid.Row="1" Text="Port:" VerticalAlignment="Center" Margin="0,8,0,0" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBox x:Name="PortBox" Width="60" />
                                <TextBlock Text="Other computers connect to this port." Foreground="#555555" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="AutostartBox" Content="Start Folder Bridge when Windows starts" Margin="0,12,0,0" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Device ID" Background="{StaticResource Face}" Margin="0,10,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Copy" Margin="6,0,0,0" Click="Copy_Click" />
                        <TextBox x:Name="IdBox" IsReadOnly="True" VerticalContentAlignment="Center" />
                    </DockPanel>
                </GroupBox>
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#C00000" Margin="0,8,0,0" Visibility="Collapsed" />
            </StackPanel>
        </DockPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Margin="6,0,0,0" />
        </StackPanel>
    </Grid>
</local:XpWindow>
