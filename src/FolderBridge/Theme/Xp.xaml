<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:FolderBridge">

    <FontFamily x:Key="UiFont">Tahoma</FontFamily>
    <FontFamily x:Key="TitleFont">Trebuchet MS</FontFamily>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <SolidColorBrush x:Key="Face" Color="#ECE9D8" />
    <SolidColorBrush x:Key="LinkBlue" Color="#215DC6" />
    <SolidColorBrush x:Key="LinkHover" Color="#428EFF" />
    <SolidColorBrush x:Key="Selection" Color="#316AC5" />
    <SolidColorBrush x:Key="FieldBorder" Color="#7F9DB9" />

    <LinearGradientBrush x:Key="TitleActive" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0997FF" Offset="0" />
        <GradientStop Color="#0053EE" Offset="0.08" />
        <GradientStop Color="#0050EE" Offset="0.4" />
        <GradientStop Color="#0066FF" Offset="0.88" />
        <GradientStop Color="#0066FF" Offset="0.93" />
        <GradientStop Color="#005BFF" Offset="0.95" />
        <GradientStop Color="#003DD7" Offset="0.96" />
        <GradientStop Color="#003DD7" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TitleInactive" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A9BFEE" Offset="0" />
        <GradientStop Color="#7C99E1" Offset="0.08" />
        <GradientStop Color="#7A97DF" Offset="0.4" />
        <GradientStop Color="#8CA8EC" Offset="0.88" />
        <GradientStop Color="#8CA8EC" Offset="0.93" />
        <GradientStop Color="#84A0E8" Offset="0.95" />
        <GradientStop Color="#6F8AD3" Offset="0.96" />
        <GradientStop Color="#6F8AD3" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FrameActive" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0831D9" Offset="0" />
        <GradientStop Color="#166AEE" Offset="0.004" />
        <GradientStop Color="#0855DD" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FrameInactive" Color="#7A96DF" />

    <RadialGradientBrush x:Key="CaptionBlue" Center="0.9,0.9" GradientOrigin="0.9,0.9" RadiusX="1.27" RadiusY="1.27">
        <GradientStop Color="#0054E9" Offset="0" />
        <GradientStop Color="#2263D5" Offset="0.55" />
        <GradientStop Color="#4479E4" Offset="0.7" />
        <GradientStop Color="#A3BBEC" Offset="0.9" />
        <GradientStop Color="#FFFFFF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="CaptionBlueHover" Center="0.9,0.9" GradientOrigin="0.9,0.9" RadiusX="1.27" RadiusY="1.27">
        <GradientStop Color="#1A6CFF" Offset="0" />
        <GradientStop Color="#3B80F4" Offset="0.55" />
        <GradientStop Color="#5D95F2" Offset="0.7" />
        <GradientStop Color="#C3D4F6" Offset="0.9" />
        <GradientStop Color="#FFFFFF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="CaptionBluePressed" Center="0.1,0.1" GradientOrigin="0.1,0.1" RadiusX="1.27" RadiusY="1.27">
        <GradientStop Color="#0043C2" Offset="0" />
        <GradientStop Color="#1A52B8" Offset="0.55" />
        <GradientStop Color="#3463C8" Offset="0.7" />
        <GradientStop Color="#8EA7DE" Offset="0.9" />
        <GradientStop Color="#D8E2F7" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="CaptionRed" Center="0.9,0.9" GradientOrigin="0.9,0.9" RadiusX="1.27" RadiusY="1.27">
        <GradientStop Color="#CC4600" Offset="0" />
        <GradientStop Color="#DC6527" Offset="0.55" />
        <GradientStop Color="#CD7546" Offset="0.7" />
        <GradientStop Color="#FFCCB2" Offset="0.9" />
        <GradientStop Color="#FFFFFF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="CaptionRedHover" Center="0.9,0.9" GradientOrigin="0.9,0.9" RadiusX="1.27" RadiusY="1.27">
        <GradientStop Color="#E85A12" Offset="0" />
        <GradientStop Color="#F07B3E" Offset="0.55" />
        <GradientStop Color="#E68D60" Offset="0.7" />
        <GradientStop Color="#FFDAC8" Offset="0.9" />
        <GradientStop Color="#FFFFFF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="CaptionRedPressed" Center="0.1,0.1" GradientOrigin="0.1,0.1" RadiusX="1.27" RadiusY="1.27">
        <GradientStop Color="#A83A00" Offset="0" />
        <GradientStop Color="#B85520" Offset="0.55" />
        <GradientStop Color="#AA603A" Offset="0.7" />
        <GradientStop Color="#E8B69C" Offset="0.9" />
        <GradientStop Color="#F2D6C8" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="TaskPane" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7BA2E7" Offset="0" />
        <GradientStop Color="#6375D6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GroupHeader" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#C6D3F7" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GroupHeaderSpecial" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0055E5" Offset="0" />
        <GradientStop Color="#2663E0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Chevron" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0.3" />
        <GradientStop Color="#C2CFF3" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#ECEBE6" Offset="0.86" />
        <GradientStop Color="#D6D0C5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CDCAC3" Offset="0" />
        <GradientStop Color="#E3E2DA" Offset="0.15" />
        <GradientStop Color="#F2F1EC" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonDefaultRing" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CEE7FF" Offset="0" />
        <GradientStop Color="#BCD4F6" Offset="0.35" />
        <GradientStop Color="#89ADE4" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonHoverRing" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF0CF" Offset="0" />
        <GradientStop Color="#FDD889" Offset="0.35" />
        <GradientStop Color="#E5A01A" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ProgressGreen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#ACEDAD" Offset="0" />
        <GradientStop Color="#7BE47D" Offset="0.14" />
        <GradientStop Color="#4CDA50" Offset="0.28" />
        <GradientStop Color="#2ED330" Offset="0.42" />
        <GradientStop Color="#42D845" Offset="0.57" />
        <GradientStop Color="#76E275" Offset="0.71" />
        <GradientStop Color="#8FE791" Offset="0.85" />
        <GradientStop Color="#FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <DrawingBrush x:Key="ProgressBlocks" TileMode="Tile" Viewport="0,0,10,8" ViewportUnits="Absolute" Viewbox="0,0,10,8" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H10 V8 H0 Z" />
                <GeometryDrawing Brush="Black" Geometry="M0,0 H8 V8 H0 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <LinearGradientBrush x:Key="ScrollFaceV" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#CAD9FD" Offset="0" />
        <GradientStop Color="#B6C9F7" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrollFaceH" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CAD9FD" Offset="0" />
        <GradientStop Color="#B6C9F7" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ScrollHot" Color="#DCE6FE" />
    <SolidColorBrush x:Key="ScrollDown" Color="#A9BFF4" />

    <LinearGradientBrush x:Key="HeaderFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F3F2EB" Offset="0.75" />
        <GradientStop Color="#E3E1D6" Offset="1" />
    </LinearGradientBrush>

    <!-- Window -->

    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="21" />
        <Setter Property="Height" Value="21" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Background" Value="{StaticResource CaptionBlue}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="3" BorderBrush="White" BorderThickness="1" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CaptionBlueHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource CaptionBluePressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Background" Value="{StaticResource CaptionRed}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CaptionRedHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource CaptionRedPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="XpWindow" TargetType="local:XpWindow">
        <Setter Property="Background" Value="{StaticResource Face}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="27" ResizeBorderThickness="4" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:XpWindow">
                    <Border x:Name="Frame" Background="{StaticResource FrameActive}" BorderBrush="#00138C" BorderThickness="1">
                        <DockPanel>
                            <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="29" Margin="-1,-1,-1,0" Background="{StaticResource TitleActive}">
                                <DockPanel Margin="7,0,5,1">
                                    <Image x:Name="TitleIcon" Source="{DynamicResource Icon.App}" Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"
                                           Visibility="{TemplateBinding ShowTitleIcon, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel x:Name="Buttons" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Command="{x:Static SystemCommands.MinimizeWindowCommand}">
                                            <Path Data="M3,8 H9 V11 H3 Z" Fill="White" Width="11" Height="11" />
                                        </Button>
                                        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Margin="2,0,0,0" Command="{x:Static SystemCommands.MaximizeWindowCommand}">
                                            <Grid Width="11" Height="11">
                                                <Path Data="M1.5,1.5 H9.5 V9.5 H1.5 Z" Stroke="White" StrokeThickness="1" />
                                                <Path Data="M1,1 H10 V3.5 H1 Z" Fill="White" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="RestoreButton" Style="{StaticResource CaptionButton}" Margin="2,0,0,0" Visibility="Collapsed" Command="{x:Static SystemCommands.RestoreWindowCommand}">
                                            <Grid Width="11" Height="11">
                                                <Path Data="M3.5,2 V0.5 H10.5 V7.5 H8.5" Stroke="White" StrokeThickness="1" />
                                                <Path Data="M3,0 H11 V2 H3 Z" Fill="White" />
                                                <Path Data="M0.5,3.5 H7.5 V10.5 H0.5 Z" Stroke="White" StrokeThickness="1" />
                                                <Path Data="M0,3 H8 V5 H0 Z" Fill="White" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="CloseButton" Style="{StaticResource CaptionClose}" Margin="2,0,0,0" Command="{x:Static SystemCommands.CloseWindowCommand}">
                                            <Path Data="M2,2 L9,9 M9,2 L2,9" Stroke="White" StrokeThickness="2" Width="11" Height="11" />
                                        </Button>
                                    </StackPanel>
                                    <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock x:Name="TitleShadow" Text="{TemplateBinding Title}" Foreground="#0F1089" Margin="1,1,0,0" FontFamily="{StaticResource TitleFont}"
                                                   FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="TitleText" Text="{TemplateBinding Title}" Foreground="White" FontFamily="{StaticResource TitleFont}"
                                                   FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <Border Margin="2,0,2,2" Background="{TemplateBinding Background}">
                                <AdornerDecorator>
                                    <ContentPresenter />
                                </AdornerDecorator>
                            </Border>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="TitleBar" Property="Background" Value="{StaticResource TitleInactive}" />
                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource FrameInactive}" />
                            <Setter TargetName="TitleText" Property="Foreground" Value="#D8E4F8" />
                            <Setter TargetName="TitleShadow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Buttons" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="Frame" Property="Margin" Value="7" />
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RestoreButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="MinButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons and links -->

    <Style TargetType="Button">
        <Setter Property="MinWidth" Value="75" />
        <Setter Property="Height" Value="23" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Outer" CornerRadius="3" BorderBrush="#003C74" BorderThickness="1" Background="{StaticResource ButtonFace}">
                        <Border x:Name="Ring" CornerRadius="2" BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefaulted" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource ButtonDefaultRing}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource ButtonDefaultRing}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource ButtonHoverRing}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Outer" Property="Background" Value="{StaticResource ButtonPressed}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="Transparent" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Outer" Property="BorderBrush" Value="#C9C7BA" />
                            <Setter TargetName="Outer" Property="Background" Value="#F5F4EA" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Foreground" Value="#A19F8F" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TaskLink" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource LinkBlue}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <DockPanel Background="Transparent">
                        <Image Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Top" />
                        <TextBlock x:Name="Text" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                            <Setter Property="Foreground" Value="{StaticResource LinkHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Task pane -->

    <Style x:Key="TaskGroup" TargetType="Expander">
        <Setter Property="IsExpanded" Value="True" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="Head" Content="{TemplateBinding Header}" Focusable="False" Cursor="Hand" FontWeight="Bold"
                                      Background="{StaticResource GroupHeader}" Foreground="{StaticResource LinkBlue}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Height="25" CornerRadius="5,5,0,0" Background="{TemplateBinding Background}" Padding="11,0,4,0">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Width="18" Height="18" CornerRadius="9" Background="{StaticResource Chevron}" BorderBrush="#B0C1EF" BorderThickness="1">
                                                <Path x:Name="Chevron" Data="M4,7.5 L7.5,4 L11,7.5 M4,11 L7.5,7.5 L11,11" Stroke="#215DC6" StrokeThickness="1.6" Width="15" Height="15"
                                                      RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ContentPresenter x:Name="Title" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleY="-1" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chevron" Property="Stroke" Value="#428EFF" />
                                            <Setter TargetName="Title" Property="Opacity" Value="0.8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border x:Name="Body" Background="#D6DFF7" BorderBrush="White" BorderThickness="1,0,1,1" Padding="10,9,10,4">
                            <ContentPresenter />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Special">
                            <Setter TargetName="Head" Property="Background" Value="{StaticResource GroupHeaderSpecial}" />
                            <Setter TargetName="Head" Property="Foreground" Value="White" />
                            <Setter TargetName="Body" Property="Background" Value="#EFF3FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TaskList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource LinkBlue}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Margin" Value="-4,0,-4,3" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="2" Padding="4,2">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource LinkHover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Selection}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DetailTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TitleFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="#0B2A7A" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#0B2A7A" />
    </Style>

    <!-- Common controls -->

    <Style TargetType="GroupBox">
        <Setter Property="Background" Value="White" />
        <Setter Property="Padding" Value="12,6,12,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Border Margin="0,7,0,0" CornerRadius="4" BorderBrush="#D0D0BF" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Margin="0,4,0,0" />
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,0,0,0" Padding="3,0" Background="{TemplateBinding Background}">
                            <ContentPresenter ContentSource="Header" TextElement.Foreground="#0046D5" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="17" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="3" BorderBrush="#686868" BorderThickness="1" Background="White" Padding="3,2">
                        <Grid x:Name="PART_Track">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{StaticResource ProgressGreen}" OpacityMask="{StaticResource ProgressBlocks}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
        <Setter Property="Padding" Value="2,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#F5F4EA" />
                            <Setter Property="Foreground" Value="#ACA899" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="13" Height="13" BorderBrush="#1C5180" BorderThickness="1" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#DCDBD5" Offset="0" />
                                    <GradientStop Color="#FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Border x:Name="Hot" BorderBrush="#F8B636" BorderThickness="2" Visibility="Collapsed" Opacity="0.8" />
                                <Path x:Name="Mark" Data="M2,5.5 L4.5,8 L9,3" Stroke="#21A121" StrokeThickness="2" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ContentPresenter Margin="5,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#CAC8BB" />
                            <Setter TargetName="Mark" Property="Stroke" Value="#CAC8BB" />
                            <Setter Property="Foreground" Value="#ACA899" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="3,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Selection}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#FFFFE1" BorderBrush="Black" BorderThickness="1" Padding="4,2">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lists -->

    <Style TargetType="ListView">
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid>
                        <Border x:Name="Bd" Height="21" Background="{StaticResource HeaderFace}" BorderBrush="#D5D2CA" BorderThickness="0,0,0,3">
                            <ContentPresenter Margin="6,0" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <Rectangle Width="1" Fill="#C7C5B2" HorizontalAlignment="Right" Margin="0,4,0,7" />
                        <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="8" Margin="0,0,-4,0" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#F9B119" />
                        </Trigger>
                        <Trigger Property="Role" Value="Padding">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#D5D2CA" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Height" Value="19" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="Transparent">
                        <GridViewRowPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Selection}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scroll bars -->

    <Style x:Key="ScrollArrow" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{StaticResource ScrollFaceV}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="Bd" CornerRadius="2" BorderBrush="#A3B9EF" BorderThickness="1" Background="{TemplateBinding Background}" Margin="0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScrollHot}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScrollDown}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollTrack" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ThumbBody" TargetType="Thumb">
        <Border x:Name="Bd" CornerRadius="2" BorderBrush="#A3B9EF" BorderThickness="1" Background="{TemplateBinding Background}" Margin="0.5">
            <ContentPresenter Content="{TemplateBinding Tag}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScrollHot}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ScrollDown}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="VerticalScroll" TargetType="ScrollBar">
        <Grid Background="#F4F3EE">
            <Grid.RowDefinitions>
                <RowDefinition Height="17" />
                <RowDefinition Height="*" />
                <RowDefinition Height="17" />
            </Grid.RowDefinitions>
            <RepeatButton Style="{StaticResource ScrollArrow}" Command="ScrollBar.LineUpCommand">
                <Path Data="M0.5,4.5 L4,1 L7.5,4.5" Stroke="#4D6185" StrokeThickness="2" />
            </RepeatButton>
            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollTrack}" Command="ScrollBar.PageUpCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Template="{StaticResource ThumbBody}" Background="{StaticResource ScrollFaceV}">
                        <Thumb.Tag>
                            <Path Data="M0,0.5 H7 M0,2.5 H7 M0,4.5 H7 M0,6.5 H7" Stroke="#8CA4E4" StrokeThickness="1" />
                        </Thumb.Tag>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollTrack}" Command="ScrollBar.PageDownCommand" />
                </Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Row="2" Style="{StaticResource ScrollArrow}" Command="ScrollBar.LineDownCommand">
                <Path Data="M0.5,1 L4,4.5 L7.5,1" Stroke="#4D6185" StrokeThickness="2" />
            </RepeatButton>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScroll" TargetType="ScrollBar">
        <Grid Background="#F4F3EE">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="17" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="17" />
            </Grid.ColumnDefinitions>
            <RepeatButton Style="{StaticResource ScrollArrow}" Background="{StaticResource ScrollFaceH}" Command="ScrollBar.LineLeftCommand">
                <Path Data="M4.5,0.5 L1,4 L4.5,7.5" Stroke="#4D6185" StrokeThickness="2" />
            </RepeatButton>
            <Track x:Name="PART_Track" Grid.Column="1">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollTrack}" Command="ScrollBar.PageLeftCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Template="{StaticResource ThumbBody}" Background="{StaticResource ScrollFaceH}">
                        <Thumb.Tag>
                            <Path Data="M0.5,0 V7 M2.5,0 V7 M4.5,0 V7 M6.5,0 V7" Stroke="#8CA4E4" StrokeThickness="1" />
                        </Thumb.Tag>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollTrack}" Command="ScrollBar.PageRightCommand" />
                </Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Column="2" Style="{StaticResource ScrollArrow}" Background="{StaticResource ScrollFaceH}" Command="ScrollBar.LineRightCommand">
                <Path Data="M1,0.5 L4.5,4 L1,7.5" Stroke="#4D6185" StrokeThickness="2" />
            </RepeatButton>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="17" />
        <Setter Property="MinWidth" Value="17" />
        <Setter Property="Template" Value="{StaticResource VerticalScroll}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="17" />
                <Setter Property="Template" Value="{StaticResource HorizontalScroll}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Menus -->

    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="White" BorderBrush="#ACA899" BorderThickness="1" Padding="2">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Height="20" Background="Transparent" MinWidth="160">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Icon" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Selection}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#ACA899" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="#ACA899" Margin="1,3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
